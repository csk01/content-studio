# Names only. Never commit real values.
# Option A: path to the OAuth client JSON downloaded from Google Cloud Console (Desktop app)
STUDIO_YT_CLIENT_SECRETS_FILE=
# Option B: explicit values
STUDIO_YT_CLIENT_ID=
STUDIO_YT_CLIENT_SECRET=
# Facebook (Meta app; see docs/12-facebook-setup.md)
STUDIO_FB_APP_ID=
STUDIO_FB_APP_SECRET=
# Optional: choose a Page if you manage several
STUDIO_FB_PAGE_ID=
# Optional: Facebook Login for Business configuration id (use instead of scopes)
STUDIO_FB_CONFIG_ID=
# Optional: must match the Valid OAuth Redirect URI in the Meta app (default 8765)
STUDIO_FB_REDIRECT_PORT=
# Optional: Facebook Login for Business configuration id for Instagram (docs/13-instagram-setup.md)
STUDIO_IG_CONFIG_ID=
# Where the SQLite DB lives (default: ~/.studio)
STUDIO_HOME=
